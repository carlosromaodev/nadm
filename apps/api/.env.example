NODE_ENV=development
PORT=3333

# Runtime da aplicação: papel restrito, sem UPDATE/DELETE no razão nem na auditoria.
DATABASE_URL="postgresql://nadm_app:nadm_app@localhost:5436/nadm?schema=public"
# Migrações e introspecção: papel dono. Nunca usado pelo processo em execução.
DIRECT_DATABASE_URL="postgresql://nadm:nadm@localhost:5436/nadm?schema=public"

CORS_ORIGIN=http://localhost:3001

# fake | multicaixa — ver docs/sdd.md §11.1 e DP-04
PAYMENTS_PROVIDER=fake
# Comissão por lado em pontos base. 500 = 5%. Ver DP-07.
PLATFORM_FEE_BP=500

# dev | real — o adaptador `dev` recusa arrancar com NODE_ENV=production. Ver DP-01.
AUTH_ADAPTER=dev

# fake | real — só `fake` tem implementação enquanto DP-03 não fechar.
NOTIFICATIONS_PROVIDER=fake

# Levantamento mínimo, em cêntimos. 500 000 = 5 000,00 Kz. Ver RN-054.
MINIMUM_PAYOUT_MINOR=500000

# ── Os três agendadores, em milissegundos. `0` desliga cada um.
# Prazos: expiração de propostas (T13) e aprovação automática (T10).
DEAL_DEADLINE_SWEEP_MS=60000
# Reconciliação: cruza o que o sistema diz com o que o sistema fez (SDD §11.5).
RECONCILIATION_SWEEP_MS=3600000
# Despacho de notificações a partir de `outbox_events`.
OUTBOX_SWEEP_MS=15000
